<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\nelkano_home\Service\ReportWorkflow;
use Drupal\nelkano_home\Service\WorkflowStatus;

/** Implements hook_form_BASE_FORM_ID_alter() for report create/edit forms. */
function nelkano_home_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  if ($form_state->getFormObject()->getEntity()->bundle() === 'hu') {
    $allowed = array_map([WorkflowStatus::class, 'termId'], WorkflowStatus::HU_CODES);
    if (isset($form[WorkflowStatus::FIELD]['widget']['#options'])) {
      $form[WorkflowStatus::FIELD]['widget']['#options'] = array_intersect_key($form[WorkflowStatus::FIELD]['widget']['#options'], array_flip($allowed));
    }
    return;
  }
  if ($form_state->getFormObject()->getEntity()->bundle() !== 'nelkano_error_report') {
    return;
  }
  $form['#validate'][] = 'nelkano_home_validate_report_workflow';
  if (isset($form['field_report_observations']['widget'][0]['value'])) {
    $form['field_report_observations']['widget'][0]['value']['#maxlength'] = ReportWorkflow::MAX_OBSERVATIONS_LENGTH;
    $form['field_report_observations']['widget'][0]['value']['#description'] = t('Indica el motivo si el reporte queda Bloqueado. Máximo 4000 caracteres; texto sin formato.');
  }
}

/** Enforces the same blocked-reason requirement as the PC API. */
function nelkano_home_validate_report_workflow(array &$form, FormStateInterface $form_state): void {
  try {
    ReportWorkflow::validateUpdate([
      'status' => WorkflowStatus::codeForId((int) $form_state->getValue([WorkflowStatus::FIELD, 0, 'target_id'])),
      'observations' => $form_state->getValue(['field_report_observations', 0, 'value']) ?? '',
    ]);
  }
  catch (\InvalidArgumentException $e) {
    $form_state->setErrorByName('field_report_observations', $e->getMessage());
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function nelkano_home_page_attachments_alter(array &$attachments): void {
  $route_name = \Drupal::routeMatch()->getRouteName() ?: '';
  if (!str_starts_with($route_name, 'nelkano_home.admin')) {
    return;
  }

  $attachments['#attached']['library'] = array_values(array_filter(
    $attachments['#attached']['library'] ?? [],
    static fn(string $library): bool => !preg_match('/^(claro|seven|gin|adminimal_admin_toolbar)\//', $library),
  ));
}

/**
 * Implements hook_theme().
 */
function nelkano_home_theme(): array {
  return [
    'nelkano_report_detail' => ['variables' => ['report' => []]],
    'nelkano_backlog' => ['variables' => ['columns' => [], 'create_url' => '', 'total' => 0, 'sprint' => '', 'sprints' => [], 'filter_url' => '']],
    'nelkano_home' => [
      'variables' => [
        'content' => [],
        'language' => 'es',
        'alternate_url' => '/en',
        'logo_url' => '',
      ],
      'template' => 'nelkano-home',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for the core login form.
 */
function nelkano_home_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = 'nelkano_home_user_login_redirect_submit';
}

/**
 * Redirects Nelkano editors to their limited admin area after login.
 */
function nelkano_home_user_login_redirect_submit(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();
  if (in_array('nelkano_editor', $account->getRoles(), TRUE)) {
    $form_state->setRedirect('nelkano_home.admin');
  }
}

/**
 * Implements hook_mail().
 */
function nelkano_home_mail(string $key, array &$message, array $params): void {
  $message['headers']['From'] = 'Nelkano <contacto@nelkano.com>';
  $message['headers']['Sender'] = 'contacto@nelkano.com';

  if ($key === 'account_verify') {
    $name = trim((string) ($params['name'] ?? 'jugador'));
    $verify_url = trim((string) ($params['verify_url'] ?? ''));
    $message['subject'] = 'Activa tu cuenta de Nelkano';
    $message['body'][] = "Hola {$name},";
    $message['body'][] = 'Gracias por unirte a Nelkano. Verifica tu correo para activar tu cuenta y preparar el acceso a las funciones web del proyecto.';
    $message['body'][] = 'Abre este enlace para verificar tu cuenta:';
    $message['body'][] = $verify_url;
    $message['body'][] = 'Este enlace caduca en 24 horas.';
    $message['body'][] = 'Nelkano no incluye juegos, ROMs ni BIOS. Tu cuenta sirve para conectar tu experiencia con tus propios archivos compatibles y tus datos del emulador.';
    return;
  }

  if ($key === 'contact_message') {
    $message['headers']['MIME-Version'] = '1.0';
    $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
    $name = htmlspecialchars((string) ($params['name'] ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $mail = htmlspecialchars((string) ($params['mail'] ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $subject = htmlspecialchars((string) ($params['subject'] ?? 'Contacto Nelkano'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
    $body = nl2br(htmlspecialchars((string) ($params['message'] ?? ''), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'));
    $message['subject'] = '[Nelkano] ' . $subject;
    $message['body'][] = nelkano_home_email_template(
      'Nuevo mensaje desde nelkano.com',
      'Consulta recibida desde la pagina de contacto.',
      [
        '<strong>Nombre:</strong> ' . $name,
        '<strong>Email:</strong> ' . $mail,
        '<strong>Asunto:</strong> ' . $subject,
        '<strong>Mensaje:</strong><br>' . $body,
      ],
      NULL,
      NULL,
    );
  }
}

function nelkano_home_email_template(string $title, string $lead, array $paragraphs, ?string $buttonText, ?string $buttonUrl): string {
  $content = '';
  foreach ($paragraphs as $paragraph) {
    $content .= '<p style="margin:0 0 16px;color:#cbd5e1;font-size:16px;line-height:1.6;">' . $paragraph . '</p>';
  }

  $button = '';
  if ($buttonText && $buttonUrl) {
    $button = '<p style="margin:28px 0 0;"><a href="' . $buttonUrl . '" style="background:#a414ff;border-radius:12px;color:#ffffff;display:inline-block;font-size:16px;font-weight:800;padding:14px 22px;text-decoration:none;">' . htmlspecialchars($buttonText, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</a></p>';
  }

  $logo_url = \Drupal::request()->getSchemeAndHttpHost() . '/' . \Drupal::service('extension.list.module')->getPath('nelkano_home') . '/assets/logo-88.png';

  return '<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>'
    . '<body style="background:#060606;margin:0;padding:0;font-family:Inter,Segoe UI,Arial,sans-serif;color:#ffffff;">'
    . '<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#060606;margin:0;padding:32px 16px;"><tr><td align="center">'
    . '<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;background:#0b0b0d;border:1px solid #272727;border-radius:18px;overflow:hidden;">'
    . '<tr><td style="padding:32px 32px 12px;">'
    . '<img src="' . htmlspecialchars($logo_url, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '" width="64" height="64" alt="Nelkano" style="border-radius:18px;display:block;">'
    . '<h1 style="font-size:30px;line-height:1.1;margin:24px 0 10px;color:#ffffff;font-weight:900;">' . htmlspecialchars($title, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</h1>'
    . '<p style="margin:0 0 24px;color:#b8b8c4;font-size:17px;line-height:1.6;">' . htmlspecialchars($lead, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</p>'
    . $content
    . $button
    . '<p style="border-top:1px solid #272727;margin:30px 0 0;padding-top:18px;color:#8b93a3;font-size:13px;line-height:1.5;">Nelkano es un proyecto de emulacion gratuito. No distribuimos juegos, ROMs ni BIOS. Usa solo archivos compatibles sobre los que tengas derechos.</p>'
    . '</td></tr></table>'
    . '</td></tr></table></body></html>';
}

/** Implements hook_node_presave(). Enforces numbers and workflow on all writes. */
function nelkano_home_node_presave(\Drupal\node\NodeInterface $node): void {
  if (!in_array($node->bundle(), ['hu', 'nelkano_error_report'], TRUE) || !$node->hasField(WorkflowStatus::FIELD)) {
    return;
  }
  if ($node->get(WorkflowStatus::FIELD)->isEmpty()) {
    WorkflowStatus::set($node, 'new');
  }
  $code = WorkflowStatus::get($node);
  if ($node->bundle() === 'hu') {
    if (!in_array($code, WorkflowStatus::HU_CODES, TRUE)) {
      throw new \InvalidArgumentException('Estado no válido para una HU.');
    }
    $node->setUnpublished();
    if ($node->isNew()) {
      $serial = \Drupal::database()->insert('nelkano_hu_sequence')->useDefaults(['id'])->execute();
      $node->set('field_hu_number', (int) $serial - 1);
    }
    else {
      $node->set('field_hu_number', $node->getOriginal()->get('field_hu_number')->value);
    }
  }
  else {
    // Compatibility mirror; taxonomy is the sole source for current behavior.
    $node->set('field_report_status', $code);
  }
}

/** Implements hook_node_access(). HU remain private even if publication is edited. */
function nelkano_home_node_access(\Drupal\node\NodeInterface $node, $op, \Drupal\Core\Session\AccountInterface $account): \Drupal\Core\Access\AccessResultInterface {
  if ($node->bundle() === 'hu') {
    return ($account->hasPermission('administer nelkano backlog') ? \Drupal\Core\Access\AccessResult::allowed() : \Drupal\Core\Access\AccessResult::forbidden())->cachePerPermissions()->addCacheableDependency($node);
  }
  return \Drupal\Core\Access\AccessResult::neutral();
}

/** Keep API codes stable while administrators may rename their taxonomy labels. */
function nelkano_home_taxonomy_term_presave(\Drupal\taxonomy\TermInterface $term): void {
  if ($term->bundle() !== WorkflowStatus::VOCABULARY) {
    return;
  }
  $code = (string) $term->get('field_workflow_code')->value;
  if (!isset(ReportWorkflow::STATUSES[$code]) || (!$term->isNew() && $term->getOriginal()->get('field_workflow_code')->value !== $code)) {
    throw new \InvalidArgumentException('El código API de este estado es fijo. Puedes editar su nombre.');
  }
  $duplicates = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['vid' => WorkflowStatus::VOCABULARY, 'field_workflow_code' => $code]);
  foreach ($duplicates as $duplicate) {
    if ($duplicate->id() !== $term->id()) {
      throw new \InvalidArgumentException('Este código de estado ya existe.');
    }
  }
}

/** Required workflow terms cannot be removed while the module is installed. */
function nelkano_home_taxonomy_term_predelete(\Drupal\taxonomy\TermInterface $term): void {
  if ($term->bundle() === WorkflowStatus::VOCABULARY) {
    throw new \InvalidArgumentException('Este estado es necesario para las HU y la API de reportes. Puedes editar su nombre.');
  }
}

/** Field defaults resolve by API code so configuration never embeds local tids. */
function nelkano_home_default_workflow_status($entity, $definition): array {
  return [['target_id' => WorkflowStatus::termId('new')]];
}

/** Avoid presenting deletion actions for terms required by existing API clients. */
function nelkano_home_taxonomy_term_access(\Drupal\taxonomy\TermInterface $term, $op, \Drupal\Core\Session\AccountInterface $account): \Drupal\Core\Access\AccessResultInterface {
  return $term->bundle() === WorkflowStatus::VOCABULARY && $op === 'delete'
    ? \Drupal\Core\Access\AccessResult::forbidden()->addCacheableDependency($term)
    : \Drupal\Core\Access\AccessResult::neutral();
}

/** Explain the immutable integration code in the native taxonomy form. */
function nelkano_home_form_taxonomy_term_form_alter(array &$form, FormStateInterface $form_state): void {
  $term = $form_state->getFormObject()->getEntity();
  if ($term->bundle() === WorkflowStatus::VOCABULARY && !$term->isNew()) {
    $form['field_workflow_code']['#disabled'] = TRUE;
    $form['field_workflow_code']['#description'] = t('Código estable de la API. Puedes cambiar el nombre visible del estado.');
  }
}
