<section class="r-gradient r-index-hero">
  <div class="r-wrap">
    <nav class="r-crumb" aria-label="{{ page.heading }}"><a href="{{ nav_home_url }}">{{ language == 'en' ? 'Home' : 'Inicio' }}</a><span>/</span><span>{{ page.eyebrow }}</span></nav>
    <p class="r-label">{{ page.eyebrow }}</p>
    <h1>{{ page.heading }}</h1>
    <p class="r-copy">{{ page.intro }}</p>
  </div>
</section>
{% set has_rules_action = page.rules_form is defined or page.rules_login_url is defined %}
<div class="r-wrap r-guide-layout{% if has_rules_action %} r-rules-layout{% endif %}">
  <aside>
    <details class="r-guide-toc" open>
      <summary>{{ language == 'en' ? 'On this page' : 'En esta página' }}</summary>
      <ol>{% for section in page.sections %}<li><a href="#section-{{ loop.index }}"><span>{{ loop.index }}.</span>{{ section.title }}</a></li>{% endfor %}</ol>
    </details>
  </aside>
  <section id="page-content" class="r-guide-sections">
    {% for section in page.sections %}
      <article id="section-{{ loop.index }}">
        <h2><span>{{ loop.index }}</span>{{ section.title }}</h2>
        {% if section.paragraphs is defined %}{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}{% else %}<p>{{ section.description }}</p>{% endif %}
        {% if section.link is defined %}<p><a href="{{ section.link.url }}">{{ section.link.label }}</a></p>{% endif %}
      </article>
    {% endfor %}
  </section>
  {% if has_rules_action %}
    <section class="r-rules-participation" aria-labelledby="rules-participation-title">
      <h2 id="rules-participation-title">{{ language == 'en' ? 'Join the conversation' : 'Participar en Comunidad' }}</h2>
      <p>{{ language == 'en' ? 'Accept these rules to post, comment or send messages.' : 'Acepta estas normas para publicar, comentar o enviar mensajes.' }}</p>
      {% if page.rules_form is defined %}
        {{ page.rules_form }}
      {% else %}
        <a class="r-btn" href="{{ page.rules_login_url }}">{{ language == 'en' ? 'Log in' : 'Iniciar sesión' }}</a>
      {% endif %}
      <small>{{ language == 'en' ? 'Version' : 'Versión' }} {{ page.rules_version }}</small>
    </section>
  {% endif %}
</div>
