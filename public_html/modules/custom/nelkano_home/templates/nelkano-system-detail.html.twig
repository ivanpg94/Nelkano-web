<section class="r-gradient r-detail-hero"><div class="r-wrap"><nav class="r-crumb" aria-label="{{ labels.systems }}"><a href="{{ nav_home_url }}">{{ labels.home }}</a><span>/</span><a href="{{ systems_url }}">{{ labels.systems }}</a><span>/</span><span aria-current="page">{{ page.short_name }}</span></nav><div class="r-detail-heading"><div><div class="r-badges"><span class="r-pill r-pill-{{ page.tier }}">{{ page.tier_label }}</span><span class="r-meta">{{ page.manufacturer }}{% if page.year %} · {{ page.year }}{% endif %}</span></div><h1>{{ page.title }}</h1>{% if page.tagline %}<p class="r-copy">{{ page.tagline }}</p>{% endif %}{% if page.formats %}<div class="r-formats"><span>{{ labels.formats }}:</span>{% for format in page.formats %}<code>{{ format }}</code>{% endfor %}</div>{% endif %}</div><div class="r-console"><img src="{{ page.image_url }}" alt="" width="130" height="130" fetchpriority="high"></div></div></div></section>
{% if page.status_note and page.tier in ['basico','experimental'] %}<div class="r-warning"><div class="r-wrap">{{ page.status_note }}</div></div>{% endif %}
<div class="r-wrap r-detail-layout"><div class="r-detail-main">
{% if page.overview %}<section><h2>{{ labels.about|replace({'{system}':page.short_name}) }}</h2><p>{{ page.overview }}</p></section>{% endif %}
{% if page.features %}<section><h2>{{ labels.features }}</h2><ul class="r-list">{% for item in page.features %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}
{% if page.limitations %}<section><h2>{{ labels.limitations }}</h2><ul class="r-list r-limits">{% for item in page.limitations %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}
{% if page.steps %}<section><h2>{{ labels.steps|replace({'{system}':page.short_name}) }}</h2><ol class="r-steps">{% for item in page.steps %}<li><h3>{{ item.title }}</h3><p>{{ item.description }}</p></li>{% endfor %}</ol></section>{% endif %}
{% if page.faq %}<section><h2>{{ labels.faq|replace({'{system}':page.short_name}) }}</h2><div class="r-faq">{% for item in page.faq %}<details name="system-faq"><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>{% endfor %}</div></section>{% endif %}
</div><aside><div class="r-sidebar-inner"><div class="r-panel"><h2>{{ labels.facts }}</h2><dl>{% for key in ['manufacturer','year'] %}{% if attribute(page,key) %}<div><dt>{{ attribute(labels,key) }}</dt><dd>{{ attribute(page,key) }}</dd></div>{% endif %}{% endfor %}<div><dt>{{ labels.category }}</dt><dd>{{ page.tier_label }}</dd></div>{% if page.formats %}<div><dt>{{ labels.formats }}</dt><dd>{{ page.formats|join(', ') }}</dd></div>{% endif %}</dl></div>{% if related %}<div class="r-panel"><h2>{{ labels.related }}</h2><ul class="r-related">{% for item in related %}<li><a href="{{ item.url }}"><img src="{{ item.image_url }}" alt="" loading="lazy">{{ item.title }}</a></li>{% endfor %}</ul></div>{% endif %}<a class="r-compat-link" href="{{ page.compatibility_url }}">{{ labels.compatibility }} →<small>{{ labels.compatibility_description }}</small></a><a class="r-btn r-ghost" href="{{ systems_url }}">← {{ labels.back }}</a></div></aside></div>