<section class="r-gradient r-index-hero r-guide-hero"><div class="r-wrap"><p class="r-label">{{ guide.eyebrow }}</p><h1>{{ guide.title }}</h1><p class="r-copy">{{ guide.intro }}</p></div></section><div class="r-wrap r-guide-layout"><aside><details class="r-guide-toc" open><summary>{{ guide.toc_label }}</summary><nav aria-label="{{ guide.toc_label }}"><ol>{% for section in guide.sections %}<li><a href="#guide-{{ loop.index }}"><span>{{ '%02d'|format(loop.index) }}</span>{{ section.title }}</a></li>{% endfor %}</ol></nav></details></aside><div class="r-guide-sections">{% for section in guide.sections %}<article id="guide-{{ loop.index }}"><h2><span>{{ loop.index }}</span>{{ section.title }}</h2><div class="{{ section.image_url ? 'r-guide-columns' : '' }}"><div><p>{{ section.description }}</p><ul>{% for item in section.bullets %}<li>{{ item }}</li>{% endfor %}</ul></div>{% if section.image_url %}<a class="r-guide-image" href="{{ section.image_url }}" data-r-lightbox aria-label="{{ guide.zoom_label }}"><img src="{{ section.image_url }}" alt="{{ section.title }}" loading="lazy"></a>{% endif %}</div></article>{% else %}<p>{{ guide.empty_label }}</p>{% endfor %}</div></div><dialog class="r-lightbox"><button type="button" aria-label="{{ guide.close_label }}">×</button><img alt=""></dialog><script defer src="{{ guide_js }}"></script>