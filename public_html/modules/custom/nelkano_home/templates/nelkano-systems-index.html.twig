<section class="r-gradient r-index-hero"><div class="r-wrap"><nav class="r-crumb" aria-label="{{ labels.systems }}"><a href="{{ nav_home_url }}">{{ labels.home }}</a><span>/</span><span>{{ labels.systems }}</span></nav><p class="r-label">{{ labels.index_eyebrow }}</p><h1>{{ labels.index_title }}</h1><p class="r-copy">{{ labels.index_description }}</p></div></section><div class="r-wrap r-index-body"><div class="r-categories">{% for key, cat in categories %}<a class="r-category" href="{{ systems_url }}{{ filter == key ? '' : '?nivel=' ~ key }}" aria-current="{{ filter == key ? 'true' : 'false' }}"><span class="r-pill r-pill-{{ key }}">{{ cat.label }}</span><p>{{ cat.description }}</p></a>{% endfor %}</div><nav class="r-filters" aria-label="{{ labels.filter }}"><a class="r-filter" href="{{ systems_url }}" aria-current="{{ not filter ? 'true' : 'false' }}">{{ labels.all }} <small>({{ total }})</small></a>{% for key, cat in categories %}<a class="r-filter" href="{{ systems_url }}?nivel={{ key }}" aria-current="{{ filter == key ? 'true' : 'false' }}">{{ cat.label }} <small>({{ cat.count }})</small></a>{% endfor %}</nav><div class="r-grid">{% for item in items %}{% include '@nelkano_home/nelkano-redesign-card.html.twig' with {home_card:false} %}{% endfor %}</div>{% if not items %}<p class="r-empty">{{ labels.empty }}</p>{% endif %}</div>