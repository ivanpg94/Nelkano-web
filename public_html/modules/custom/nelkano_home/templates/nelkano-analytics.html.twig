{% if analytics.ga_id %}
  <script>
    (function () {
      var GA_ID = '{{ analytics.ga_id|e('js') }}';
      var STORAGE_KEY = 'nelkano_analytics_consent';
      var CONSENT_VERSION = '2026-10-31.1';
      // Conservative technical renewal policy: 730 days, not a statutory limit.
      var CONSENT_DURATION_MS = 730 * 24 * 60 * 60 * 1000;
      var INTERNAL_STORAGE_KEY = 'nelkano_analytics_internal';
      var EXCLUDE_INTERNAL = {{ analytics.exclude_internal|default(false) ? 'true' : 'false' }};
      var consentTimer = null;
      var pageRefusal = false;

      if (EXCLUDE_INTERNAL) {
        try {
          window.localStorage.setItem(INTERNAL_STORAGE_KEY, '1');
        }
        catch (error) {}
      }

      function isInternalTraffic() {
        if (EXCLUDE_INTERNAL) {
          return true;
        }
        try {
          return window.localStorage.getItem(INTERNAL_STORAGE_KEY) === '1';
        }
        catch (error) {
          return false;
        }
      }

      function disableAnalytics() {
        window['ga-disable-' + GA_ID] = true;
        window.clearTimeout(consentTimer);
        consentTimer = null;
        clearAnalyticsCookies();
      }

      function clearAnalyticsCookies() {
        var names;
        try {
          names = document.cookie.split(';').map(function (cookie) {
            return cookie.split('=')[0].trim();
          }).filter(function (name) {
            return /^_ga(?:_[A-Za-z0-9_-]+)?$/.test(name);
          });
        }
        catch (error) {
          return;
        }
        if (!names.length) {
          return;
        }
        var paths = ['/'];
        var pathname = window.location.pathname;
        if (!/[;\r\n]/.test(pathname)) {
          var parts = pathname.split('/').filter(Boolean);
          for (var index = 1; index <= parts.length; index++) {
            var prefix = '/' + parts.slice(0, index).join('/');
            paths.push(prefix, prefix + '/');
          }
        }
        var domains = [''];
        var labels = window.location.hostname.toLowerCase().split('.');
        for (var offset = 0; offset < labels.length - 1; offset++) {
          var domain = labels.slice(offset).join('.');
          domains.push(domain, '.' + domain);
        }
        names.forEach(function (name) {
          paths.forEach(function (cookiePath) {
            domains.forEach(function (domain) {
              try {
                document.cookie = name + '=; Max-Age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=' + cookiePath
                  + (domain ? '; domain=' + domain : '')
                  + (window.location.protocol === 'https:' ? '; Secure' : '') + '; SameSite=Lax';
              }
              catch (error) {}
            });
          });
        });
      }

      function isLocalEnvironment() {
        var host = window.location.hostname.toLowerCase();
        return host === 'localhost'
          || host === '127.0.0.1'
          || host === '::1'
          || host === '[::1]'
          || host.endsWith('.local')
          || host.endsWith('.test')
          || /^10\./.test(host)
          || /^192\.168\./.test(host)
          || /^172\.(1[6-9]|2[0-9]|3[0-1])\./.test(host);
      }

      function newConsentRecord(value) {
        var now = Date.now();
        return {
          version: CONSENT_VERSION,
          choice: value,
          date: new Date(now).toISOString(),
          expiresAt: new Date(now + CONSENT_DURATION_MS).toISOString()
        };
      }

      function saveConsent(value, migrated) {
        var record = newConsentRecord(value);
        if (migrated) {
          record.source = 'legacy-denied';
        }
        try {
          window.localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
          pageRefusal = value === 'denied';
          return record;
        }
        catch (error) {
          if (value === 'denied') {
            pageRefusal = true;
          }
          return null;
        }
      }

      function readConsent() {
        var raw;
        try {
          raw = window.localStorage.getItem(STORAGE_KEY);
          if (raw === 'denied') {
            // Preserve refusal. Its date records migration, not an invented acceptance.
            return saveConsent('denied', true) || newConsentRecord('denied');
          }
          if (!raw) {
            return null;
          }
          if (raw !== 'granted') {
            var record = JSON.parse(raw);
            var date = record && typeof record.date === 'string' ? Date.parse(record.date) : NaN;
            var expiry = record && typeof record.expiresAt === 'string' ? Date.parse(record.expiresAt) : NaN;
            if (record && record.version === CONSENT_VERSION
              && (record.choice === 'granted' || record.choice === 'denied')
              && isFinite(date) && isFinite(expiry) && date <= Date.now()
              && expiry > Date.now() && expiry > date && expiry - date <= CONSENT_DURATION_MS
              && new Date(date).toISOString() === record.date
              && new Date(expiry).toISOString() === record.expiresAt) {
              return record;
            }
          }
          // Old acceptance has no date or notice version. Notify other tabs too.
          window.localStorage.removeItem(STORAGE_KEY);
        }
        catch (error) {
          return null;
        }
        return null;
      }

      function consentValue() {
        var record = readConsent();
        return record ? record.choice : null;
      }

      function measurementAllowed() {
        return !pageRefusal && !isLocalEnvironment() && !isInternalTraffic() && consentValue() === 'granted';
      }

      function scheduleConsentExpiry(record) {
        window.clearTimeout(consentTimer);
        consentTimer = null;
        if (record) {
          consentTimer = window.setTimeout(syncConsent, Math.min(Date.parse(record.expiresAt) - Date.now(), 2147483647));
        }
      }

      function cleanUrl(value) {
        try {
          var url = new URL(value);
          return url.protocol === 'https:' || url.protocol === 'http:' ? url.origin + url.pathname : '';
        }
        catch (error) {
          return '';
        }
      }

      function loadAnalytics() {
        var record = readConsent();
        if (pageRefusal || isLocalEnvironment() || isInternalTraffic() || !record || record.choice !== 'granted') {
          disableAnalytics();
          if (!isLocalEnvironment() && !isInternalTraffic()) {
            scheduleConsentExpiry(record);
          }
          return;
        }
        scheduleConsentExpiry(record);
        window['ga-disable-' + GA_ID] = false;
        if (window.nelkanoAnalyticsLoaded) {
          return;
        }
        window.nelkanoAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          if (measurementAllowed()) {
            window.dataLayer.push(arguments);
          }
          else {
            disableAnalytics();
          }
        };
        window.gtag('js', new Date());
        window.gtag('config', GA_ID, {
          anonymize_ip: true,
          transport_type: 'beacon',
          cookie_expires: 63072000,
          cookie_update: false,
          send_page_view: false,
          page_location: cleanUrl(window.location.href),
          page_referrer: cleanUrl(document.referrer)
        });
        window.gtag('event', 'page_view', {
          page_location: cleanUrl(window.location.href),
          page_referrer: cleanUrl(document.referrer)
        });

        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(script);
      }

      function downloadDetails(link) {
        var url;
        try {
          url = new URL(link.getAttribute('href'), window.location.href);
        }
        catch (error) {
          return null;
        }
        if (url.origin !== window.location.origin) {
          return null;
        }
        var match = url.pathname.match(/^\/descargar\/(es|en)\/(?:(android|windows|steamos|sdk)\/)?([0-9][A-Za-z0-9.+_-]{0,79})(\/instalador)?\/?$/);
        if (!match || (match[4] && !match[2])) {
          return null;
        }
        var platform = match[2] || 'android';
        return {
          download_product: platform === 'sdk' ? 'sdk_studio' : 'nelkano',
          download_platform: platform === 'sdk' ? 'windows' : platform,
          download_version: match[3],
          link_url: url.origin + url.pathname
        };
      }

      function trackDownload(link) {
        if (!measurementAllowed()) {
          disableAnalytics();
          return;
        }
        if (typeof window.gtag !== 'function') {
          return;
        }
        var details = downloadDetails(link);
        if (details) {
          window.gtag('event', 'nelkano_download_click', details);
          return;
        }
        if (!link.hasAttribute('data-analytics-event')) {
          return;
        }
        var linkUrl = '';
        try {
          var url = new URL(link.getAttribute('href'), window.location.href);
          linkUrl = url.origin + url.pathname;
        }
        catch (error) {}
        window.gtag('event', link.getAttribute('data-analytics-event') || 'download_click', {
          platform: link.getAttribute('data-analytics-platform') || '',
          file_name: link.getAttribute('data-analytics-file') || '',
          link_url: linkUrl
        });
      }

      function hideBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (banner) {
          banner.hidden = true;
        }
      }

      function showBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (banner && !isLocalEnvironment() && !isInternalTraffic()) {
          banner.hidden = false;
        }
      }

      function resetConsent() {
        disableAnalytics();
        saveConsent('denied');
        showBanner();
      }

      function syncConsent() {
        loadAnalytics();
        if (isLocalEnvironment() || isInternalTraffic() || consentValue()) {
          hideBanner();
        }
        else {
          showBanner();
        }
      }

      function bindConsentBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (!banner) {
          return;
        }

        if (isLocalEnvironment() || isInternalTraffic()) {
          banner.hidden = true;
          return;
        }

        banner.querySelector('[data-consent-accept]').addEventListener('click', function () {
          if (saveConsent('granted')) {
            hideBanner();
          }
          loadAnalytics();
        });
        banner.querySelector('[data-consent-reject]').addEventListener('click', function () {
          saveConsent('denied');
          disableAnalytics();
          hideBanner();
        });
        syncConsent();
      }

      function bindConsentSettings() {
        var buttons = document.querySelectorAll('[data-consent-settings]');
        buttons.forEach(function (button) {
          button.addEventListener('click', resetConsent);
        });
      }

      document.addEventListener('click', function (event) {
        var link = event.target && typeof event.target.closest === 'function'
          ? event.target.closest('a[href], [data-analytics-event]') : null;
        if (link) {
          trackDownload(link);
        }
      });

      window.addEventListener('storage', function (event) {
        if (event.key === null || event.key === INTERNAL_STORAGE_KEY || event.key === STORAGE_KEY) {
          if (event.key === null || event.key === STORAGE_KEY) {
            pageRefusal = false;
          }
          syncConsent();
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        bindConsentBanner();
        bindConsentSettings();
      });
      loadAnalytics();
    }());
  </script>
{% endif %}
