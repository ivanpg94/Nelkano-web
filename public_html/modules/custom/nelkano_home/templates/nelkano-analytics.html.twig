{% if analytics.ga_id %}
  <script>
    (function () {
      var GA_ID = '{{ analytics.ga_id|e('js') }}';
      var STORAGE_KEY = 'nelkano_analytics_consent';
      var INTERNAL_STORAGE_KEY = 'nelkano_analytics_internal';
      var EXCLUDE_INTERNAL = {{ analytics.exclude_internal|default(false) ? 'true' : 'false' }};

      if (EXCLUDE_INTERNAL) {
        try {
          window.localStorage.setItem(INTERNAL_STORAGE_KEY, '1');
        }
        catch (error) {}
      }

      function isInternalTraffic() {
        if (EXCLUDE_INTERNAL) {
          return true;
        }
        try {
          return window.localStorage.getItem(INTERNAL_STORAGE_KEY) === '1';
        }
        catch (error) {
          return false;
        }
      }

      function disableAnalytics() {
        window['ga-disable-' + GA_ID] = true;
      }

      function isLocalEnvironment() {
        var host = window.location.hostname.toLowerCase();
        return host === 'localhost'
          || host === '127.0.0.1'
          || host === '::1'
          || host.endsWith('.local')
          || host.endsWith('.test')
          || /^10\./.test(host)
          || /^192\.168\./.test(host)
          || /^172\.(1[6-9]|2[0-9]|3[0-1])\./.test(host);
      }

      function consentValue() {
        try {
          return window.localStorage.getItem(STORAGE_KEY);
        }
        catch (error) {
          return null;
        }
      }

      function saveConsent(value) {
        try {
          window.localStorage.setItem(STORAGE_KEY, value);
        }
        catch (error) {}
      }

      function loadAnalytics() {
        if (isLocalEnvironment() || isInternalTraffic() || consentValue() !== 'granted') {
          disableAnalytics();
          return;
        }
        window['ga-disable-' + GA_ID] = false;
        if (window.nelkanoAnalyticsLoaded) {
          return;
        }
        window.nelkanoAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', GA_ID, {
          anonymize_ip: true,
          transport_type: 'beacon'
        });

        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(script);
      }

      function downloadDetails(link) {
        var url;
        try {
          url = new URL(link.getAttribute('href'), window.location.href);
        }
        catch (error) {
          return null;
        }
        if (url.origin !== window.location.origin) {
          return null;
        }
        var match = url.pathname.match(/^\/descargar\/(es|en)\/(?:(android|windows|steamos|sdk)\/)?([0-9][A-Za-z0-9.+_-]{0,79})(\/instalador)?\/?$/);
        if (!match || (match[4] && !match[2])) {
          return null;
        }
        var platform = match[2] || 'android';
        return {
          download_product: platform === 'sdk' ? 'sdk_studio' : 'nelkano',
          download_platform: platform === 'sdk' ? 'windows' : platform,
          download_version: match[3],
          link_url: url.origin + url.pathname
        };
      }

      function trackDownload(link) {
        if (isLocalEnvironment() || isInternalTraffic() || consentValue() !== 'granted'
          || typeof window.gtag !== 'function') {
          return;
        }
        var details = downloadDetails(link);
        if (details) {
          window.gtag('event', 'nelkano_download_click', details);
          return;
        }
        if (!link.hasAttribute('data-analytics-event')) {
          return;
        }
        var linkUrl = '';
        try {
          var url = new URL(link.getAttribute('href'), window.location.href);
          linkUrl = url.origin + url.pathname;
        }
        catch (error) {}
        window.gtag('event', link.getAttribute('data-analytics-event') || 'download_click', {
          platform: link.getAttribute('data-analytics-platform') || '',
          file_name: link.getAttribute('data-analytics-file') || '',
          link_url: linkUrl
        });
      }

      function hideBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (banner) {
          banner.hidden = true;
        }
      }

      function showBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (banner && !isLocalEnvironment()) {
          banner.hidden = false;
        }
      }

      function resetConsent() {
        disableAnalytics();
        try {
          window.localStorage.removeItem(STORAGE_KEY);
        }
        catch (error) {}
        showBanner();
      }

      function bindConsentBanner() {
        var banner = document.querySelector('[data-consent-banner]');
        if (!banner) {
          return;
        }

        if (isLocalEnvironment()) {
          banner.hidden = true;
          return;
        }

        banner.querySelector('[data-consent-accept]').addEventListener('click', function () {
          saveConsent('granted');
          hideBanner();
          loadAnalytics();
        });
        banner.querySelector('[data-consent-reject]').addEventListener('click', function () {
          saveConsent('denied');
          disableAnalytics();
          hideBanner();
        });
        banner.hidden = !!consentValue();
        if (consentValue()) {
          loadAnalytics();
        }
      }

      function bindConsentSettings() {
        var buttons = document.querySelectorAll('[data-consent-settings]');
        buttons.forEach(function (button) {
          button.addEventListener('click', resetConsent);
        });
      }

      document.addEventListener('click', function (event) {
        var link = event.target && typeof event.target.closest === 'function'
          ? event.target.closest('a[href], [data-analytics-event]') : null;
        if (link) {
          trackDownload(link);
        }
      });

      window.addEventListener('storage', function (event) {
        if (event.key === INTERNAL_STORAGE_KEY || event.key === STORAGE_KEY) {
          loadAnalytics();
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        bindConsentBanner();
        bindConsentSettings();
      });
      loadAnalytics();
    }());
  </script>
{% endif %}
