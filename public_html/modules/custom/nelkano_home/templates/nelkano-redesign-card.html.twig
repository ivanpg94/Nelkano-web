<a class="r-card" href="{{ item.url }}"><div class="r-card-top"><img src="{{ item.image_url }}" alt="" width="48" height="48" loading="lazy"><span class="r-pill r-pill-{{ item.tier }}">{{ item.tier_label }}</span></div><div class="r-card-content"><{{ home_card ? 'h3' : 'h2' }}>{{ home_card ? item.short_name : item.card_title }}</{{ home_card ? 'h3' : 'h2' }}><p>{{ home_card ? item.tagline : item.summary }}</p></div>{% if not home_card %}<div class="r-card-bottom"><span>{{ item.year }}</span><span>{{ labels.more }} →</span></div>{% endif %}</a>