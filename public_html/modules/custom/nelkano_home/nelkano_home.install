/**
 * Copies a packaged APK to public files and returns its URI.
 */
function nelkano_home_public_release_apk_uri(string $filename): string {
  $directory = 'public://nelkano-releases';
  $file_system = \Drupal::service('file_system');
  $file_system->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);

  $destination = $directory . '/' . $filename;
  if (!is_file($file_system->realpath($destination) ?: '')) {
    $module_path = \Drupal::service('extension.list.module')->getPath('nelkano_home');
    $source = DRUPAL_ROOT . '/' . $module_path . '/emulator/' . $filename;
    if (!is_file($source)) {
      $source = DRUPAL_ROOT . '/../' . $module_path . '/emulator/' . $filename;
    }
    if (!is_file($source)) {
      return '';
    }
    $file_system->copy($source, $destination, \Drupal\Core\File\FileExists::Replace);
  }

  $files = \Drupal::entityTypeManager()
    ->getStorage('file')
    ->loadByProperties(['uri' => $destination]);
  $file = reset($files);
  if (!$file) {
    $file = \Drupal\file\Entity\File::create([
      'uri' => $destination,
      'status' => 1,
    ]);
  }
  $file->setPermanent();
  $file->save();

  return $destination;
}

/**
 * Friendship table schema.
 */
function nelkano_home_friendship_schema(): array {
  return [
    'description' => 'Nelkano friendship invitations and accepted relationships.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'requester_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'recipient_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'pending',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'requester' => ['requester_uid'],
      'recipient' => ['recipient_uid'],
      'status' => ['status'],
    ],
    'unique keys' => [
      'pair' => ['requester_uid', 'recipient_uid'],
    ],
  ];
}

/**
 * Multiplayer game session table schema.
 */
function nelkano_home_game_session_schema(): array {
  return [
    'description' => 'Nelkano multiplayer game sessions. Stores no ROMs, saves or save states.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'session_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'host_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'guest_uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'host_device_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'guest_device_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'system' => ['type' => 'varchar', 'length' => 24, 'not null' => TRUE, 'default' => 'GBA'],
      'mode' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => 'LINK_CABLE'],
      'rom_hash' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'pending'],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'expires' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'closed' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'session_id' => ['session_id'],
      'host_uid' => ['host_uid'],
      'guest_uid' => ['guest_uid'],
      'status' => ['status'],
      'expires' => ['expires'],
    ],
    'unique keys' => [
      'session_unique' => ['session_id'],
    ],
  ];
}

