/** Add editable core information pages and retain existing home card copy. */
function nelkano_home_update_11026(): void {
  \Drupal\nelkano_home\Service\SystemPages::install();
}

/** Reduce published compatibility catalogs to the five public CSV fields. */
function nelkano_home_update_11027(): void {
  \Drupal\nelkano_home\Service\CompatibilityCatalog::migrateStored();
}

/** Apply the Figma public/editorial redesign without modifying API configuration. */
function nelkano_home_update_11028(): void {
  \Drupal\nelkano_home\Service\RedesignContent::install();
}

/** Seed the new editable guide; do not change any existing page content. */
function nelkano_home_update_11029(): void {
  $config=\Drupal::configFactory()->getEditable('nelkano_home.guide');
  if ($config->isNew()) {
    $config->setData(\Drupal\Component\Serialization\Yaml::decode(file_get_contents(__DIR__.'/config/install/nelkano_home.guide.yml')))->save();
  }
}

/** Import the system copy authored in Figma into matching Spanish pages. */
function nelkano_home_update_11030(): void {
  foreach (['nelkano_home.settings','nelkano_home.docs'] as $name) {
    $editable=\Drupal::configFactory()->getEditable($name);
    if ($editable->get('langcode')===NULL) { $editable->set('langcode','es')->save(); }
  }
  $seed=json_decode(file_get_contents(__DIR__.'/config/figma-system-copy.json'),TRUE);
  $config=\Drupal::configFactory()->getEditable('nelkano_home.systems');
  foreach ($seed as $id=>$fields) {
    $page=$config->get('es.pages.'.$id);
    if (is_array($page)) { $config->set('es.pages.'.$id,array_replace($page,$fields)); }
  }
  $labels=json_decode(file_get_contents(__DIR__.'/config/figma-redesign.json'),TRUE)['labels'];
  foreach ($labels as $language=>$values) {
    foreach ($values as $key=>$label) {$config->set($language.'.labels.'.$key,$label);}
  }
  $config->save();
}

/** Add centralized SEO configuration without overwriting existing metadata. */
function nelkano_home_update_11031(): void {
  $config=\Drupal::configFactory()->getEditable('nelkano_home.seo');
  if ($config->isNew()) {$config->setData(['langcode'=>'es','es'=>['pages'=>[]],'en'=>['pages'=>[]]])->save();}
}

/** Unify system publication across languages, retaining any existing hidden state. */
function nelkano_home_update_11032(): void {
  $config=\Drupal::configFactory()->getEditable('nelkano_home.systems');
  foreach ($config->get('es.pages')??[] as $id=>$page) {
    $other=$config->get('en.pages.'.$id);
    if (!is_array($other)) {continue;}
    $visible=!empty($page['enabled']) && !empty($other['enabled']);
    $config->set('es.pages.'.$id.'.enabled',$visible)->set('en.pages.'.$id.'.enabled',$visible);
  }
  $config->save();
}

/** Add optimized header avatars, keeping uploaded originals and APIs unchanged. */
function nelkano_home_update_11033(): void {
  \Drupal::service('module_installer')->install(['image']);
  if (!\Drupal\image\Entity\ImageStyle::load('nelkano_header_avatar')) {
    $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents(__DIR__ . '/config/install/image.style.nelkano_header_avatar.yml'));
    \Drupal\image\Entity\ImageStyle::create($data)->save();
  }
}

/** Add rotating app sessions (API v2); legacy 30-day tokens keep working. */
function nelkano_home_update_11034(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('nelkano_app_session')) {
    $schema->createTable('nelkano_app_session', nelkano_home_app_session_schema());
  }
}

/**
 * App session table schema: one row per access/refresh token generation.
 */
function nelkano_home_app_session_schema(): array {
  return [
    'description' => 'Nelkano app sessions. Stores only SHA-256 hashes of access and refresh tokens.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'family_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'device_id' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'platform' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'device_name' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE, 'default' => ''],
      'access_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'access_expires' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'refresh_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'refresh_expires' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'last_used' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'rotated' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'revoked' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'access_hash' => ['access_hash'],
      'refresh_hash' => ['refresh_hash'],
    ],
    'indexes' => [
      'family' => ['family_id'],
      'uid_revoked' => ['uid', 'revoked'],
      'refresh_expires' => ['refresh_expires'],
    ],
    'foreign keys' => [
      'app_session_user' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];
}

/**
 * Implements hook_requirements().
 *
 * Shows where the app signing key comes from and the public key the app pins.
 */
function nelkano_home_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  if (!function_exists('sodium_crypto_sign_detached')) {
    return [
      'nelkano_app_signing' => [
        'title' => 'Nelkano: firma de la app',
        'value' => 'Falta la extension PHP sodium',
        'severity' => REQUIREMENT_ERROR,
      ],
    ];
  }
  $source = \Drupal\nelkano_home\Service\AppEntitlements::keySource();
  $public = \Drupal\nelkano_home\Service\AppEntitlements::publicKeyBase64();
  $kid = \Drupal\nelkano_home\Service\AppEntitlements::keyId();
  return [
    'nelkano_app_signing' => [
      'title' => 'Nelkano: firma de la app',
      'value' => 'Clave publica (kid ' . $kid . '): ' . $public,
      'description' => $source === 'state'
        ? 'La semilla se genero automaticamente y esta en la base de datos (state). Recomendado: moverla a settings.php como $settings[\'nelkano_app_signing_seed\'] con scripts/app-signing-key.php.'
        : 'Semilla leida de ' . ($source === 'settings' ? 'settings.php' : 'la variable NELKANO_APP_SIGNING_SEED') . '.',
      'severity' => $source === 'state' ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    ],
  ];
}
