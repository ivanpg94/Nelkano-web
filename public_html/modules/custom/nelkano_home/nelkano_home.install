/**
 * Move the first beta APK to public files and link it from release config.
 */
function nelkano_home_update_11012(): void {
  $uri = nelkano_home_public_release_apk_uri('Nelkano 1.0.0-beta.apk');
  if ($uri === '') {
    return;
  }

  $config = \Drupal::configFactory()->getEditable('nelkano_home.docs');
  foreach (['es', 'en'] as $language) {
    $items = $config->get($language . '.releases_items') ?? [];
    if (!is_array($items)) {
      continue;
    }
    foreach ($items as &$item) {
      if (is_array($item) && ($item['version'] ?? '') === '1.0.0-beta') {
        $item['apk_file'] = $uri;
      }
    }
    unset($item);
    $config->set($language . '.releases_items', $items);
  }
  $config->save(TRUE);
}

